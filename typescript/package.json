{
  "name": "@getkite/sdk",
  "version": "0.1.0",
  "description": "Emit events from your application into Kite's ingest pipeline as CloudEvents.",
  "license": "MIT",
  "author": "Alpha Centauri Cyberspace",
  "homepage": "https://getkite.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alpha-Centauri-Cyberspace/kite-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Alpha-Centauri-Cyberspace/kite-sdk/issues"
  },
  "keywords": [
    "kite",
    "webhook",
    "cloudevents",
    "events",
    "ingest"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:package": "node ../scripts/verify-typescript-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
